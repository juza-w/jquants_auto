# このファイルを .env にコピーして値を入れる（.env はコミットしない）
JQUANTS_API_KEY=
# J-Quants のプラン別レート上限（リクエスト/分）: Free=5, Light=60, Standard=120, Premium=500
JQUANTS_REQUESTS_PER_MIN=5
# Claude 判断層（未設定なら Claude なしで、ルールのシグナルだけ通知する）
ANTHROPIC_API_KEY=
# ニュース検索を止めるときは 0
NEWS_SEARCH=1
# Discord の Webhook URL（未設定なら通知は画面表示のみ）。URL を知っている人は誰でも投稿できるので秘密にする
DISCORD_WEBHOOK_URL=
